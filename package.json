{
  "name": "dpdp-ready",
  "version": "0.2.0",
  "description": "Open-source scanner that maps personal data, third-party processors and leaked secrets in your code and website, to help engineering teams prepare for India's DPDP Act. Runs locally; your code never leaves your machine.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "dpdp-ready": "dist/cli.js"
  },
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec \"test/*.test.ts\"",
    "scan": "node src/cli.ts scan"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shriraj1901/dpdp-ready.git"
  },
  "homepage": "https://github.com/Shriraj1901/dpdp-ready#readme",
  "bugs": {
    "url": "https://github.com/Shriraj1901/dpdp-ready/issues"
  },
  "keywords": [
    "dpdp",
    "privacy",
    "india",
    "personal-data",
    "data-protection",
    "static-analysis",
    "github-action",
    "sarif"
  ]
}
